# --- Meta WhatsApp Cloud API (only for real WhatsApp; not needed for the browser tester) ---
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=netcare-verify-123
APP_SECRET=
GRAPH_API_VERSION=v23.0
PORT=3001

# --- Where appointment / call-back requests go ---
# mock = demo only: nothing is sent anywhere, a reference number is generated | http = your real intake service (see README)
NETCARE_PROVIDER=mock
NETCARE_API_URL=
NETCARE_API_KEY=

# --- Optional AI routing (Claude) for messages the rules can't classify ---
# Leave the key empty to run on rules only. Set AI_MODE=off to disable even if a key is present.
# Only the user's free-text question is sent (long numbers are redacted) – get Netcare/POPIA approval first.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_MODE=auto
